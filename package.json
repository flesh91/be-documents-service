{
    "name": "documents-service",
    "version": "1.68.0",
    "main": "dist/index.js",
    "repository": "https://github.com/diia-open-source/be-documents-service.git",
    "author": "Diia",
    "license": "SEE LICENSE IN LICENSE.md",
    "engines": {
        "node": ">=20"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "prepare": "ts-patch install -s",
        "build": "rimraf dist/ && mkdir dist && npm run genproto && npx tsc",
        "start": "node dist/index.js",
        "dev": "tsc-watch --skipLibCheck --onSuccess 'node dist/index.js' | pino-pretty -S",
        "semantic-release": "semantic-release",
        "lint": "eslint --ext .ts .",
        "lint-fix": "eslint '*/**/*.{js,ts}' --fix",
        "lint:lockfile": "lockfile-lint --path package-lock.json --allowed-hosts registry.npmjs.org --validate-https",
        "format": "prettier --write \"src/**/*.ts\"",
        "test": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest",
        "test:unit": "npm run test --selectProjects unit --",
        "test:unit:coverage": "npm run test --selectProjects unit --coverage",
        "test:integration": "npm run test --selectProjects integration --",
        "migrate-deploy": "npm run migrate up",
        "migrate-ci": "npm run migrate up",
        "migrate-test": "NODE_ENV=test npm run migrate up",
        "migrate": "sh -c 'ts-node --project migrations/tsconfig.json node_modules/.bin/migrate-mongo $0 $1 -f migrate-mongo-config.ts'",
        "indexes:sync": "MONGO_INDEXES_SYNC=true MONGO_INDEXES_EXIT_AFTER_SYNC=true npm run start",
        "find-circulars": "madge --circular --extensions ts ./",
        "scaffold": "scaffold",
        "genproto": "genproto --outputDir src/generated"
    },
    "dependencies": {
        "@diia-inhouse/analytics": "1.61.0",
        "@diia-inhouse/crypto": "1.11.0",
        "@diia-inhouse/damaged-property-service-client": "1.0.0-121310",
        "@diia-inhouse/db": "4.12.0",
        "@diia-inhouse/diia-app": "18.1.0",
        "@diia-inhouse/diia-gov-gateway-client": "1.0.0-94716",
        "@diia-inhouse/diia-logger": "3.3.0",
        "@diia-inhouse/diia-metrics": "3.12.0",
        "@diia-inhouse/diia-queue": "8.0.0",
        "@diia-inhouse/env": "1.16.0",
        "@diia-inhouse/errors": "1.10.0",
        "@diia-inhouse/healthcheck": "1.12.0",
        "@diia-inhouse/http": "1.9.0",
        "@diia-inhouse/i18n": "2.3.0",
        "@diia-inhouse/redis": "2.13.0",
        "@diia-inhouse/super-gen-client": "1.0.0-160166",
        "@diia-inhouse/types": "6.41.0",
        "@diia-inhouse/user-service-client": "1.0.0-146079",
        "@diia-inhouse/utils": "3.6.0",
        "@diia-inhouse/validators": "1.17.0",
        "awilix": "10.0.2",
        "compare-versions": "6.1.1",
        "country-iso-3-to-2": "1.1.1",
        "ean13-lib": "0.0.5",
        "glob": "11.0.0",
        "is-base64": "1.1.0",
        "lodash": "4.17.21",
        "luhn-string": "1.2.3",
        "luxon": "3.7.2",
        "migrate-mongo": "11.0.0",
        "module-alias": "2.2.3",
        "moment": "2.30.1",
        "nice-grpc-common": "2.0.2",
        "pluralize": "8.0.0",
        "type-fest": "4.8.3",
        "uuid": "10.0.0",
        "xml2js": "0.6.2"
    },
    "devDependencies": {
        "@diia-inhouse/configs": "2.0.0",
        "@diia-inhouse/eslint-config": "5.1.0",
        "@diia-inhouse/genproto": "2.0.0",
        "@diia-inhouse/scaffold": "2.23.0",
        "@diia-inhouse/test": "6.4.0",
        "@types/is-base64": "1.1.3",
        "@types/jest": "29.5.12",
        "@types/jest-when": "3.5.5",
        "@types/lodash": "4.17.7",
        "@types/node": "20.14.11",
        "@types/pluralize": "0.0.33",
        "@types/uuid": "10.0.0",
        "@types/xml2js": "0.4.14",
        "@typescript-eslint/eslint-plugin": "7.16.1",
        "eslint": "8.57.0",
        "eslint-plugin-jest": "28.6.0",
        "eslint-plugin-unicorn": "54.0.0",
        "jest": "29.7.0",
        "jest-when": "3.6.0",
        "lockfile-lint": "4.14.0",
        "madge": "7.0.0",
        "nice-grpc": "2.1.9",
        "nock": "13.5.4",
        "prettier": "3.3.3",
        "rimraf": "6.0.1",
        "semantic-release": "24.0.0",
        "ts-node": "10.9.2",
        "ts-patch": "3.2.1",
        "typescript": "5.2.2"
    },
    "resolutions": {
        "@babel/traverse": "7.23.2"
    },
    "_moduleAliases": {
        "@services": "dist/services",
        "@providers": "dist/providers",
        "@interfaces": "dist/interfaces",
        "@models": "dist/models",
        "@dataMappers": "dist/dataMappers",
        "@utils": "dist/utils",
        "@src": "dist"
    },
    "release": {
        "extends": "@diia-inhouse/configs/dist/semantic-release/service"
    },
    "commitlint": {
        "extends": "@diia-inhouse/configs/dist/commitlint"
    },
    "eslintConfig": {
        "extends": "@diia-inhouse/eslint-config"
    },
    "jest": {
        "preset": "@diia-inhouse/configs/dist/jest"
    },
    "prettier": "@diia-inhouse/eslint-config/prettier",
    "madge": {
        "tsConfig": "./tsconfig.json"
    }
}
